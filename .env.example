# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ajaia_doc_editor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async SQLAlchemy Database URL (postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ajaia_doc_editor

# Application Settings
APP_NAME="Ajaia Doc Editor"
ENVIRONMENT=development
API_PREFIX=/api

# Dev Server Proxy Target (used only by Vite dev server to proxy /api requests)
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
